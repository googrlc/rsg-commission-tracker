# --- Supabase (required) --------------------------------------------------
# Project: wibscqhkvpijzqbhjphg (rsg-infrastructure).
# Copy this file to .env.local and fill in the real values.
#
# Use the URL + the PUBLISHABLE key only. Both are browser-safe and gated by
# Row Level Security. NEVER put the service_role / secret key in this frontend.
# VITE_-prefixed names are read directly by Vite; the plain SUPABASE_* names are
# also accepted (vite.config.ts bridges them for the AI Studio Secrets panel).
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Optional / legacy ----------------------------------------------------
# GEMINI_API_KEY: only if the app's Gemini features are used. AI Studio injects
# this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL where this app is hosted (Cloud Run service URL). Used as the
# magic-link redirect origin. AI Studio injects this at runtime.
APP_URL="MY_APP_URL"
